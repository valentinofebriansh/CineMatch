# Salin file ini menjadi ".env" lalu isi nilainya. JANGAN commit file ".env".
DB_HOST=db
DB_PORT=3306
DB_USER=root
DB_PASSWORD=ganti_dengan_password_database
DB_NAME=cinematch
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Model Qwen hasil fine-tuning yang berjalan LOKAL lewat Ollama (lihat docs/LOKAL_OLLAMA.md di paket handover).
# Kosong = otomatis memakai mode rules.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=cinematch
OLLAMA_TIMEOUT=28
# Cara lama via server Colab (tidak dipakai bila OLLAMA_URL terisi):
QWEN_API_URL=
QWEN_API_KEY=
